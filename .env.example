# ==================================================
# NAVA BOT - ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env for local development.
# In Vercel, set these under Project Settings -> Environment Variables.
# NEVER commit a real .env file.
# ==================================================

# ---- Telegram ----
BOT_TOKEN=
WEBHOOK_SECRET=
PUBLIC_URL=https://nava-jjl6.vercel.app

# ---- MongoDB ----
MONGODB_URI=
MONGODB_DB_NAME=nava

CRON_SECRET=

# ---- Optional default profile photos ----
# file_id (یا لینک https عمومی) که وقتی کاربر عکس آپلود نکرده، بر اساس
# جنسیتش نشون داده میشه. برای گرفتن file_id: عکس رو با کپشن دقیقاً
# "fileid" به خود ربات بفرست (ادمین)، ربات آیدیش رو بهت برمی‌گردونه.
DEFAULT_PHOTO_MALE=
DEFAULT_PHOTO_FEMALE=

# ---- بنر دعوت دوستان ----
# عکس بنری که موقع «دعوت دوستان» همراه پیام ارسال میشه. آیدیش رو هم با
# روش بالا (کپشن fileid) بگیر.
INVITE_BANNER_PHOTO=

# ---- عکس‌های وریفای ----
# ۵ تا عکس نمونه که کاربر باید ژست مشابهش رو بگیره. آیدی هرکدوم رو با
# کپشن "fileid" بگیر و اینجا بذار (هر کدوم رو نداشتی خالی بذار).
VERIFY_PHOTO_1=
VERIFY_PHOTO_2=
VERIFY_PHOTO_3=
VERIFY_PHOTO_4=
VERIFY_PHOTO_5=
# عکسی که همراه پیام «تایید شدی» فرستاده میشه (اختیاری، اگه خالی باشه فقط متن میره)
VERIFY_APPROVED_PHOTO=
# عکسی که همراه پیام «رد شدی» فرستاده میشه (اختیاری)
VERIFY_REJECTED_PHOTO=

# ---- Sightengine (image moderation) ----
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_THRESHOLD=0.5

# ---- Telegram Stars packages (⚠️ فقط مقدار پیش‌فرض اولیه) ----
# از این به بعد قیمت‌ها از پنل ادمین («💳 تنظیم قیمت رلیک») قابل تغییرن؛
# این مقدار فقط بار اول (قبل از این‌که از پنل چیزی تنظیم کنی) استفاده میشه.
STARS_PACKAGES=[{"stars":50,"relic":10},{"stars":100,"relic":25},{"stars":250,"relic":75}]

# ---- ربات ولت پریمیوم (Mini App جدا) ----
# توکن ربات @WalletPremiumBot (از BotFather)
WALLET_BOT_TOKEN=
# یه رشته‌ی رندوم جدید (مثل WEBHOOK_SECRET، جدا و متفاوت ازش)
WALLET_WEBHOOK_SECRET=
# آدرس https جایی که فایل‌های پوشه‌ی PREMIUM_WALLET رو میزبانی کردی
WALLET_MINIAPP_URL=https://nava-wallet.vercel.app
WALLET_BOT_USERNAME=WalletPremiumBot

# ---- Nava Mini App (کاربران + درخواست چت) ----
# اختیاری. پیش‌فرض: PUBLIC_URL + /miniapp/
NAVA_MINIAPP_URL=https://nava-jjl6.vercel.app/miniapp/

# ---- Premium / Custom Emoji ----
# کلید اصلی: false = همه‌ی اموجی‌ها معمولی (اکانت پریمیوم لازم نیست).
# وقتی پریمیوم گرفتی: این رو true کن و جلوی هر اموجی آیدی عددی بذار.
PREMIUM_EMOJI_ENABLED=false
# هر خط پایین: یا اموجی معمولی (مثل 🏠) یا آیدی عددی پریمیوم (مثل 5416041192905265756)
# یا هر دو با هم (5416041192905265756 🏠) تا اگه پریمیوم خاموش شد همین اموجی معمولی بمونه.
# ---- (قدیمی) لیست آیدی‌های پریمیوم قبلی، فقط برای مرجع ----
# مقدار عددی custom_emoji_id از یه اکانت تلگرام پریمیوم. هرکدوم رو نداشتی
# خالی بذار — ربات به شکلک معمولی (اگه توی کد براش تعریف شده) برمی‌گرده.
