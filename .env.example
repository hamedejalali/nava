# ==================================================
# NAVA BOT - ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env for local development.
# In Vercel, set these under Project Settings -> Environment Variables.
# NEVER commit a real .env file.
# ==================================================

# ---- Telegram ----
# Bot token from @BotFather
BOT_TOKEN=

# Secret token used to verify that webhook requests really come from Telegram.
# Generate any long random string yourself, e.g.: openssl rand -hex 32
WEBHOOK_SECRET=

# Public HTTPS URL of your deployed Vercel project, e.g. https://nava-bot.vercel.app
# Used only by the local set-webhook script, not by the running bot.
PUBLIC_URL=

# ---- MongoDB ----
MONGODB_URI=
MONGODB_DB_NAME=nava

# Shared secret required in the Authorization header for the
# /api/cron/expire-searches endpoint (see vercel.json "crons" + README).
CRON_SECRET=

# ---- Sightengine (image moderation) ----
# https://sightengine.com — used to auto-screen profile photos and
# in-chat images for nudity/sexual content before they're shown to anyone.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Risk score (0-1) at/above which an image is sent to the admin instead of
# being auto-approved. Optional, defaults to 0.5 if not set.
SIGHTENGINE_THRESHOLD=0.5

# ---- Telegram Stars packages (⚠️ PLACEHOLDER PRICES — REVIEW BEFORE PRODUCTION) ----
# JSON array of {stars, relic}. The project spec never defined actual
# prices, so the values below are just a working default so the payment
# flow is fully functional out of the box. Replace with real pricing.
STARS_PACKAGES=[{"stars":50,"relic":10},{"stars":100,"relic":25},{"stars":250,"relic":75}]

# ---- Premium / Custom Emoji IDs ----
# Numeric Telegram custom_emoji_id values. Must be obtained manually by the
# project owner from a Telegram Premium account. Leave empty if not available yet;
# the bot will fall back to a plain Unicode emoji and log a warning in development.
EMOJI_PREMIUM_WORLD=
EMOJI_PREMIUM_MALE=
EMOJI_PREMIUM_FEMALE=
EMOJI_PREMIUM_AGE=
EMOJI_PREMIUM_FLAG_FA=
EMOJI_PREMIUM_FLAG_EN=
EMOJI_PREMIUM_FLAG_AR=
EMOJI_PREMIUM_HOME=
EMOJI_PREMIUM_PERSON=
EMOJI_PREMIUM_GREEN_CHECK=
EMOJI_PREMIUM_GUIDE=
EMOJI_PREMIUM_ANONYMOUS=
EMOJI_PREMIUM_LOCATION=
EMOJI_PREMIUM_SEARCH=
EMOJI_PREMIUM_PROFILE=
EMOJI_PREMIUM_CROWN=
EMOJI_PREMIUM_MAILBOX=
EMOJI_PREMIUM_LETTER=
EMOJI_PREMIUM_INVITE=
EMOJI_PREMIUM_BACK=
