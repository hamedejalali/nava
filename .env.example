# ====================================================================
#  مویا (Moya) — متغیرهای محیطی (Vercel)  ·  نسخه 1.27.0
#  توکن‌ها و پسوردها دقیقاً همونی‌ان که فرستادی (دست نزدم).
#  در Vercel: Project Settings → Environment Variables
# ====================================================================

# ───────── ۱) ضروری — همیشه توی Vercel بمونن ─────────
BOT_TOKEN=
WEBHOOK_SECRET=
PUBLIC_URL=https://your-project.vercel.app
MONGODB_URI=
# ⚠️ اسم دیتابیس رو عوض نکن (حتی با تغییر اسم ربات)، وگرنه ربات به یه دیتابیس خالی وصل میشه
MONGODB_DB_NAME=nava
CRON_SECRET=
OWNER_ID=
# اختیاری: ادمین‌ها از پنل هم اضافه میشن. (توی فایل قبلی کامنت بود، همون‌طور نگه داشتم)
# ADMIN_IDS=123456789

# ───────── ۲) سرویس‌های اختیاری — کلیدهای محرمانه، فقط توی env ─────────
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# اتصال ولت (جریان «آدرس واریز»؛ راهنما: docs/WALLET_API.md). تا پر نشن، دکمه‌ی ولت مخفی می‌مونه
WALLET_API_URL=
WALLET_INTEGRATION_ID=
WALLET_API_SECRET=

# ───────── ۳) فقط برای «انتقال یک‌باره» به پنل ─────────
# بعد از دیپلوی: پنل ادمین ← ⚙️ تنظیمات ربات ← 🧩 متغیرها و تصاویر ← «⬇️ انتقال همه‌ی متغیرهای env به پنل».
# وقتی پیام «هیچ متغیر قدیمی منتقل‌نشده‌ای نمونده» رو دیدی، کل این بخش (۳) رو از Vercel پاک کن.
DEFAULT_PHOTO_MALE=
DEFAULT_PHOTO_FEMALE=
INVITE_BANNER_PHOTO=
VERIFY_PHOTO_1=
VERIFY_PHOTO_2=
VERIFY_PHOTO_3=
# (VERIFY_PHOTO_4 و ۵ توی فایل قبلی عیناً کپی عکس ۱ بودن و نمونه‌ی تکراری نشون می‌دادن؛ حذف شدن. عکس جدید رو از پنل بذار)
VERIFY_APPROVED_PHOTO=
VERIFY_REJECTED_PHOTO=
MODERATION_LOG_CHAT_ID=
BACKUP_CHANNEL_ID=
SIGHTENGINE_THRESHOLD=0.5
# قیمت پکیج‌های استارز: فقط مقدار اولیه؛ بعد از تنظیم قیمت از «💳 تنظیم قیمت ژتون» توی پنل، پاکش کن
STARS_PACKAGES=
