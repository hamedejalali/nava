{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "api/wallet.ts": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-searches",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-broadcasts",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/wallet/v1/:op",
      "destination": "/api/wallet?op=:op"
    }
  ]
}
